<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- You can now easily add net8.0 or net9.0 to this list whenever you want -->
    <TargetFrameworks>net48;net481;net6.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AssemblyName>ChronoStack</AssemblyName>
    <RootNamespace>ChronoStack</RootNamespace>

    <!-- Silences the warnings about using v10.x NuGet packages on net6.0 -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Silences the EOL warning for net6.0 -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- ========================================== -->
    <!-- NUGET PACKAGE METADATA                     -->
    <!-- ========================================== -->
    <Title>ChronoStack.NET</Title>
    <Authors>Fernando Ortiz, GenAI</Authors> <!-- Or your company/team name -->
    <Description>Enterprise-grade, zero-blocking diagnostics and telemetry library for .NET. Features throw-time context preservation, W3C Trace integration, PII redaction, and multi-tenant session tags.</Description>
    <PackageTags>logging;telemetry;diagnostics;opentelemetry;exceptions;aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Dependencies for Modern .NET (6.0, 8.0, etc.) -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <PackageReference Include="System.Text.Json" Version="10.0.3" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="9.0.13" />
  </ItemGroup>

  <!-- Dependencies for old .NET Framework (4.7.2, 4.8, etc.) -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog" Version="6.1.2" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChronoStack.Tests" />
  </ItemGroup>
</Project>
